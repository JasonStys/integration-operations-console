{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "target": "ES2023"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "tests/browser/**/*.ts"]
}
